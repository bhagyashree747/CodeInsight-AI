# CodeInsight AI - LLM Configuration
# Provider selection: "mock", "openai_compat", or "ollama"
# Default is "mock" if unset
LLM_PROVIDER=mock

# Base URL for openai_compat provider
# Google Gemini OpenAI-compatible: https://generativelanguage.googleapis.com/v1beta/openai/
# Groq: https://api.groq.com/openai/v1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# API key for the chosen provider
LLM_API_KEY=your_api_key_here

# Model identifier
# Google Gemini: gemini-2.5-flash or gemini-1.5-flash
# Groq: llama-3.3-70b-versatile
# Ollama: qwen2.5-coder:7b
LLM_MODEL=gemini-2.5-flash

# Optional request timeout in seconds (default: 30)
LLM_TIMEOUT=30
